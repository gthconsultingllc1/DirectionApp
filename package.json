{
  "name": "direction-native",
  "version": "1.1.0",
  "description": "Direction Capacitor shell (Android + iOS WebView)",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/patch-native-purchases.js",
    "sync": "npx cap sync",
    "open": "npx cap open android",
    "build:aab": "cd android && ./gradlew bundleRelease",
    "build:apk": "cd android && ./gradlew assembleRelease",
    "ios:deployment-target": "node scripts/set-ios-deployment-target.js",
    "test": "node --test test/direction-iap.test.js"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/core": "^7.4.3",
    "@capacitor/ios": "^7.4.3",
    "@capacitor/splash-screen": "^7.0.3",
    "@capgo/native-purchases": "7.19.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.3"
  }
}
